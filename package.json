{
  "name": "pulp-cocktails",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fruit-forward cocktail website, built with React, Three.js and GSAP.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/check-project.mjs",
    "check:release": "node scripts/check-project.mjs --release",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "verify": "npm run lint && npm test && npm run check && npm run build",
    "assets:optimize": "node scripts/optimize-assets.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "lucide-react": "^1.72.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
